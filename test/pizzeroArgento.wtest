import tp-juego.jugador.*
import tp-juego.barra.*
import tp-juego.cliente.*

describe "Pizzero Argento" {
	test "un jugador comienza sin puntos ni pizzas y sin minijuego" {
		assert.equals(0, jugador.puntaje())
		assert.equals(0, jugador.pizzasEnMano())
		assert.equals(null, jugador.minijuegoActual())
		assert.equals(barraSuperior, jugador.barraActual())
	}

	test "el jugador suma puntos" {
		jugador.sumarPuntos(10)
		jugador.sumarPuntos(5)
		assert.equals(15, jugador.puntaje())
	}

	test "el jugador no puede tener puntaje negativo" {
		jugador.restarPuntos(30)
		assert.equals(0, jugador.puntaje())
	}

	test "preparar una pizza crea un minijuego sin clicks" {
		jugador.prepararPizza()

		assert.notThat(jugador.minijuegoActual() == null)
		assert.equals(0, jugador.minijuegoActual().clicksActuales())
		assert.equals(10, jugador.minijuegoActual().clicksTotales())
	}

	test "un minijuego no crea una pizza antes de completar los clicks" {
		jugador.prepararPizza()

        // No encontramos una forma de hacer que un número se repita N veces en Wollok, así que usamos un forEach con un rango
		(1..9).forEach({ i => jugador.minijuegoActual().registrarClick() })

		assert.equals(0, jugador.pizzasEnMano())
		assert.equals(9, jugador.minijuegoActual().clicksActuales())
	}

	test "diez clicks crean una pizza y terminan el minijuego" {
		jugador.prepararPizza()
        // No encontramos una forma de hacer que un número se repita N veces en Wollok, así que usamos un forEach con un rango
		(1..10).forEach({ i => jugador.minijuegoActual().registrarClick() })

		assert.equals(1, jugador.pizzasEnMano())
		assert.equals(null, jugador.minijuegoActual())
	}

	test "entregar sin pizzas tira una excepcion" {
		jugador.pizzasEnMano(0)
		assert.throwsExceptionWithMessage("No hay pizzas en mano para entregar", {
			jugador.entregarPedido()
		})
	}

	test "entregar en una barra sin clientes tira una excepcion" {
		jugador.pizzasEnMano(1)
		barraSuperior.clientes().clear()
		assert.throwsExceptionWithMessage("No hay clientes en esta barra", {
			jugador.entregarPedido()
		})
	}

	test "entregar la cantidad exacta saca al cliente y suma puntos" {
		jugador.pizzasEnMano(2)
		jugador.barraActual(barraSuperior)
		barraSuperior.agregarCliente(new Hambriento(pedido = 2))
		jugador.entregarPedido()
		assert.that(barraSuperior.clientes().isEmpty())
		assert.equals(10, jugador.puntaje())
		assert.equals(0, jugador.pizzasEnMano())
	}

	test "entregar menos pizzas enoja a un hambriento y no suma puntos" {
		jugador.pizzasEnMano(1)
		barraSuperior.agregarCliente(new Hambriento(pedido = 2))
		jugador.barraActual(barraSuperior)
		jugador.entregarPedido()
		assert.that(barraSuperior.clientes().isEmpty())
		assert.equals(0, jugador.puntaje())
		assert.equals(0, jugador.pizzasEnMano())
	}

	test "un critico resta puntos y no produce puntaje negativo" {
		jugador.pizzasEnMano(1)
		jugador.puntaje(20)
		barraSuperior.agregarCliente(new Critico(pedido = 2))
		jugador.barraActual(barraSuperior)
		jugador.entregarPedido()
		assert.equals(0, jugador.puntaje())
		assert.that(barraSuperior.clientes().isEmpty())
	}

	test "un jugador puede bajar" {
		jugador.barraActual(barraSuperior)
    	jugador.bajar()
    	assert.equals(barraMediaSuperior, jugador.barraActual())
	}

	test "un jugador puede subir" {
		jugador.barraActual(barraMediaSuperior)
    	jugador.subir()
		assert.equals(barraSuperior, jugador.barraActual())
	}

	test "un jugador no puede subir desde la barra superior" {
    	jugador.barraActual(barraSuperior)
    	jugador.subir()
    	assert.equals(barraSuperior, jugador.barraActual())
	}

	test "un jugador no puede bajar desde la barra inferior" {
		jugador.barraActual(barraInferior)
    	jugador.bajar()
    	assert.equals(barraInferior, jugador.barraActual())
	}
}