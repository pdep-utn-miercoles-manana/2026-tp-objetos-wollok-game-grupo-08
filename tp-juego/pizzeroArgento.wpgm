import wollok.game.*
import juego.*
import barra.*
import jugador.*

program pizzeroArgento {
    game.title("Pizzero Argento")
    game.width(12)
    game.height(9)
    
    // Añadimos las barras y al jugador visualmente
    game.addVisual(barraSuperior)
    game.addVisual(barraMediaSuperior)
    game.addVisual(barraMediaInferior)
    game.addVisual(barraInferior)
    game.addVisual(jugador)
    
    juego.iniciar()
    
    // Timer de paciencia (baja cada 1 segundo)
    game.onTick(1000, "bajarPaciencia", {
        juego.barras().forEach({ barra => 
            barra.clientes().copy().forEach({ cliente => 
                cliente.pasarTiempo(jugador)
                // Si el cliente se fue, lo removemos visualmente del juego
                if (cliente.barra() == null) {
                    game.removeVisual(cliente)
                }
            })
        })
    })

    // Controles de movimiento
    keyboard.up().onPressDo({ jugador.subir() })
    keyboard.down().onPressDo({ jugador.bajar() })
    
    // Acciones
    keyboard.x().onPressDo({ 
        jugador.prepararPizza()
        if (jugador.minijuegoActual() != null) {
            game.addVisual(jugador.minijuegoActual())
        }
    })
    
    keyboard.c().onPressDo({ 
        const clienteAtendido = jugador.barraActual().obtenerPrimerCliente()
        jugador.entregarPedido()
        game.removeVisual(clienteAtendido) // Lo quita visualmente al atenderlo
    })
    
    keyboard.space().onPressDo({ 
        if (jugador.minijuegoActual() != null) {
            jugador.minijuegoActual().registrarClick()
        }
    })

    game.start()
}